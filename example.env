# dark-souls-nex — set in PowerShell before go run .
# PC ICS: 192.168.137.1

NEXTENDO_HOST=192.168.137.1
AUTH_PORT=443
SECURE_PORT=60010
CERT_FILE=certs/server.crt
KEY_FILE=certs/server.key

# REQUIRED: 8-char NEX access key from the game main NSO (not found in plain strings yet).
# Set after you extract it, e.g.:
#   $env:ACCESS_KEY = "xxxxxxxx"
ACCESS_KEY=

NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_RELAY_ALLOW_PRIVATE=1
NEXTENDO_PROBE_REPOINT=1
NEXTENDO_RELAY_HOST=192.168.137.1
NEXTENDO_RELAY_PORT_BASE=40000
NEXTENDO_RELAY_PORT_SPAN=100
NNCS_ENABLE=1
NNCS_BIND=0.0.0.0
NNCS_SERVER_IP=192.168.137.1
DS_TRACE=1
